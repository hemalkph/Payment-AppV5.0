      "timetable_notes": [
        {
          "id": "a5ddb8e6-1cc6-4ee8-a4c5-be63730e8708",
          "body_en": "Live & repeat classes are conducted during night time. Seminars are held live on YouTube every Monday night. Paper writing classes are available in both morning and night sessions.",
          "body_si": "සජීවී පන්ති සහ නැවත පන්ති රාත්‍රී කාලයේ පවත්වනු ලැබේ. සෙමිනා YouTube ඔස්සේ සඳුදා රාත්‍රී පවත්වනු ලැබේ. ප්‍රශ්නපත්‍ර පන්ති උදේ සහ රාත්‍රී කාලයේ පවත්වනු ලැබේ.",
          "variant": "warning",
          "position": "above",
          "title_en": "Class Sessions",
          "title_si": "පන්ති වේලාවන්",
